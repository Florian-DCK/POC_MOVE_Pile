{
	"name": "proximus-enjoy",
	"version": "1.0.0",
	"description": "",
	"browserslist": [
		"defaults"
	],
	"scripts": {
		"start": "run-s clean:before dev",
		"dev": "run-p eleventy:dev js:dev",
		"build": "run-s clean:before eleventy:prod js:prod clean:after",
		"clean:before": "del-cli dist",
		"clean:after": "del-cli dist/Scripts/*.txt dist/Scripts/common.js dist/Scripts/app.js",
		"eleventy:dev": "cross-env ELEVENTY_ENV=development eleventy --serve",
		"eleventy:prod": "cross-env ELEVENTY_ENV=production eleventy",
		"js:dev": "webpack --env development",
		"js:prod": "webpack --env production",
		"install:gsap": "npm install gsap@npm:@gsap/business",
		"prepare": "husky install"
	},
	"repository": {
		"type": "git",
		"url": ""
	},
	"author": "Hilarious",
	"license": "UNLICENSED",
	"devDependencies": {
		"@11ty/eleventy": "^2.0.1",
		"@babel/core": "^7.22.17",
		"@babel/eslint-parser": "^7.19.1",
		"@babel/preset-env": "^7.18.10",
		"babel-eslint": "^10.1.0",
		"babel-loader": "^9.1.2",
		"cross-env": "^7.0.3",
		"css-loader": "^6.7.1",
		"del-cli": "^5.0.0",
		"eslint": "^8.49.0",
		"eslint-config-airbnb": "^19.0.4",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-import": "^2.28.1",
		"eslint-plugin-jsx-a11y": "^6.7.1",
		"eslint-plugin-prettier": "^5.0.0",
		"eslint-plugin-react": "^7.33.2",
		"eslint-webpack-plugin": "^4.0.1",
		"husky": "^8.0.0",
		"lint-staged": "^14.0.1",
		"markdown-it": "^13.0.1",
		"mini-css-extract-plugin": "^2.6.1",
		"npm-run-all": "^4.1.5",
		"postcss-loader": "^7.0.1",
		"prettier": "^3.0.3",
		"sass": "^1.63.6",
		"sass-loader": "^13.0.2",
		"source-map-loader": "^4.0.1",
		"ts-loader": "^9.4.4",
		"webpack": "^5.74.0",
		"webpack-cli": "^5.1.0"
	},
	"dependencies": {
		"@babylonjs/core": "^8.46.2",
		"@hilarious-be/controls-manager": "^1.0.0",
		"@hilarious-be/event-manager": "^2.0.0",
		"@hilarious-be/joystick": "^2.0.0",
		"@hilarious-be/particle-emitter": "^1.0.0",
		"@hilarious-be/timer": "^3.0.1",
		"gsap": "npm:@gsap/business@^3.12.2",
		"lodash": "^4.17.21"
	},
	"lint-staged": {
		"*": [
			"prettier --write",
			"eslint --fix"
		]
	}
}
